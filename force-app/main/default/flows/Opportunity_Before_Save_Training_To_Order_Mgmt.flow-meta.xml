            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Set_Training_on_PO</targetReference>
        </connector>
        <filterFormula>AND(OR(NOT(ISBLANK({!$Record.Training_Course_Name__c})), NOT(ISBLANK({!$Record.Training_Course_Location__c})), NOT(ISBLANK({!$Record.Training_Course_Date__c}))), OR(ISNEW(), ISCHANGED({!$Record.Training_Course_Name__c}), ISCHANGED({!$Record.Training_Course_Location__c}), ISCHANGED({!$Record.Training_Course_Date__c})))</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
