<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Run_Contact_Nuke_Batch</name>
        <label>Run Contact Nuke Batch</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <actionName>RunContactNukeBatchAction</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Success_Screen</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <description>Manually-triggered (not scheduled) cleanup: shows a confirmation warning, then on confirm kicks off NukeContactBatch, which permanently deletes every Contact flagged NUKE__c = true (subject to its own 500-record safety cap). A Contact whose parent Account is separately flagged NUKE gets removed by the Account-level cascade instead.</description>
    <environments>Default</environments>
    <interviewLabel>NUKE Contact Cleanup {!$Flow.CurrentDateTime}</interviewLabel>
    <label>NUKE Contact Cleanup</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <screens>
        <name>Confirm_Screen</name>
        <label>Confirm Screen</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Run_Contact_Nuke_Batch</targetReference>
        </connector>
        <fields>
            <name>Confirm_Warning_Text</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;font-size: 16px; color: rgb(255, 0, 0);&quot;&gt;This will PERMANENTLY delete every Contact currently flagged NUKE.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;This cannot be undone after the 15-day Recycle Bin window. A CSV report will be emailed once the batch completes.&lt;/p&gt;&lt;p&gt;Click below only if you are sure you want to proceed.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Yes, Delete Them Permanently</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Success_Screen</name>
        <label>Success Screen</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Success_Text</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;font-size: 16px; color: rgb(48, 195, 48);&quot;&gt;The NUKE Contact cleanup batch has been queued.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;You will receive an email report with the results once it completes.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
