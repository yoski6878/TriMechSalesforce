<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Proposal_Approval_Escalation_Notice</fullName>
        <description>Project 790, Requirement 7: notifies the Proposal Approval Escalation Managers group when a pending approval is reassigned to them after sitting unactioned for 24 hours. Fired by the 24 Hours After Submission scheduled path on Quote_Submit_For_Approval.</description>
        <protected>false</protected>
        <recipients>
            <recipient>Proposal_Approval_Escalation_Mgrs</recipient>
            <type>group</type>
        </recipients>
        <senderType>OrgWideEmailAddress</senderType>
        <senderAddress>noreply@trimech.com</senderAddress>
        <template>unfiled$public/Proposal_Approval_Escalation_Notice</template>
    </alerts>
    <fieldUpdates>
        <fullName>AVA_SFCLOUD__AvaTax_Update_Tax_Date</fullName>
        <field>AVA_SFCLOUD__Tax_Date__c</field>
        <formula>CreatedDate</formula>
        <name>AvaTax - Update Tax Date</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Approval_Status_Approved</fullName>
        <field>Approval_Status__c</field>
        <literalValue>Approved</literalValue>
        <name>Approval Status Approved</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Approval_Status_Rejected</fullName>
        <field>Approval_Status__c</field>
        <literalValue>Rejected</literalValue>
        <name>Approval Status Rejected</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Is_Submitted_False</fullName>
        <field>Is_Submitted__c</field>
        <literalValue>0</literalValue>
        <name>Is Submitted False</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Proposal_Approval_Set_Approved_Date</fullName>
        <field>Approved_Date__c</field>
        <formula>NOW()</formula>
        <name>Proposal Approval - Set Approved Date</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Proposal_Approval_in_Process</fullName>
        <field>Approval_Status__c</field>
        <literalValue>In Process</literalValue>
        <name>Proposal Approval in Process</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Set_Status_Approved</fullName>
        <field>Status</field>
        <literalValue>Approved</literalValue>
        <name>Set Status Approved</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Set_Status_To_Draft</fullName>
        <field>Status</field>
        <literalValue>Draft</literalValue>
        <name>Set Status To Draft</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Update_Probability</fullName>
        <field>Probability__c</field>
        <formula>CASE( TEXT( Forecast_Type__c ) ,
&quot;Most Likely&quot;, 0.75,
&quot;Commit&quot;, 0.90,
Probability__c
)</formula>
        <name>Update Probability</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>AVA_SFCLOUD__AvaTax - Update Quote Tax Date</fullName>
        <actions>
            <name>AVA_SFCLOUD__AvaTax_Update_Tax_Date</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <formula>ISBLANK (CreatedDate) = False</formula>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Update Probability</fullName>
        <actions>
            <name>Update_Probability</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <formula>ISCHANGED ( Forecast_Type__c )</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
</Workflow>
